{
  "manifest_version": 3,
  "name": "Share to Telegram",
  "description": "Shares the current page to Telegram as a plain link, a title and link, or a clickable hyperlink.",
  "version": "0.2",
  "homepage_url": "https://github.com/grub-basket/Share_to_Telegram",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_icon": "icon-128.png",
    "default_title": "Share to Telegram"
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "offscreen", "clipboardWrite"]
}
